#!/bin/bash
set -e
. "$(dirname "$0")/ci/util/keep_editable_fbuild.sh"

# Function to find Python executable
find_python() {
    if command -v python3 &> /dev/null; then
        echo "python3"
    elif command -v python &> /dev/null; then
        echo "python"
    else
        echo "Python not found. Please install Python 3."
        exit 1
    fi
}

# Check if uv is installed, if not, install it
if ! command -v uv &> /dev/null; then
    echo "uv command not found. Installing uv..."
    PYTHON=$(find_python)
    $PYTHON -m pip install uv
fi

cd "$(dirname "$0")"

# Honor uv's explicitly selected, already provisioned environment. The local
# installer provisions .venv, so it must not run for a missing external target.
if [ -n "${UV_PROJECT_ENVIRONMENT:-}" ]; then
    if [ ! -d "$UV_PROJECT_ENVIRONMENT" ]; then
        echo "UV_PROJECT_ENVIRONMENT does not name an existing environment directory: $UV_PROJECT_ENVIRONMENT" >&2
        exit 1
    fi
elif [ ! -d .venv ]; then
    ./install
fi

show_boards_stmt=""
# if no arguments
if [ $# -eq 0 ]; then
    # show supported boards list
    show_boards_stmt="--supported-boards"
fi

if [ -n "$show_boards_stmt" ]; then
    echo -e "\nSupported boards:\n"
    uv run ci/ci-compile.py $show_boards_stmt | tr ',' '\n' | sed 's/^/  /'
    echo -e "\nUsage: bash compile <board> [--examples example1,example2]\n"
else
    # Simple wrapper - all Docker/GitHub Actions detection handled in Python
    echo -e "\nRunning uv run ci/ci-compile.py $@\n"
    uv run ci/ci-compile.py "$@"
fi
